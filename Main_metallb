---
# ansible/roles/metallb/tasks/main.yml
# Installs MetalLB via Helm and configures an IP address pool.
# MetalLB gives Traefik and other LoadBalancer services a real LAN IP.

- name: Add MetalLB Helm repo
  command: helm repo add metallb https://metallb.github.io/metallb
  environment:
    KUBECONFIG: /etc/rancher/k3s/k3s.yaml
  changed_when: false

- name: Update Helm repos
  command: helm repo update
  environment:
    KUBECONFIG: /etc/rancher/k3s/k3s.yaml
  changed_when: false

- name: Install MetalLB
  command: >
    helm upgrade --install metallb metallb/metallb
    --namespace metallb-system
    --create-namespace
    --wait
    --timeout 3m
  environment:
    KUBECONFIG: /etc/rancher/k3s/k3s.yaml
  register: metallb_install
  changed_when: "'already deployed' not in metallb_install.stdout"

- name: Wait for MetalLB pods to be ready
  command: kubectl rollout status deployment/metallb-controller -n metallb-system
  environment:
    KUBECONFIG: /etc/rancher/k3s/k3s.yaml
  retries: 10
  delay: 15

- name: Apply MetalLB IP address pool
  copy:
    dest: /tmp/metallb-ippool.yml
    content: |
      apiVersion: metallb.io/v1beta1
      kind: IPAddressPool
      metadata:
        name: ctf-pool
        namespace: metallb-system
      spec:
        addresses:
          - {{ metallb_ip_range }}
      ---
      apiVersion: metallb.io/v1beta1
      kind: L2Advertisement
      metadata:
        name: ctf-l2
        namespace: metallb-system
      spec:
        ipAddressPools:
          - ctf-pool

- name: Apply MetalLB pool manifest
  command: kubectl apply -f /tmp/metallb-ippool.yml
  environment:
    KUBECONFIG: /etc/rancher/k3s/k3s.yaml
