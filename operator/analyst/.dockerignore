# Docker build context: operator/analyst
#
# Built by .github/workflows/build-analyst.yml (context: operator/analyst).
# The Dockerfile has no COPY at all -- the image is built entirely from
# RUN instructions -- so nothing in this directory is needed in the build
# context at all.
#
# This is also the backstop for the unpinned-image class of bug: even if a
# future `context: .` typo were introduced, docker/secrets/ and docker/.env
# would be excluded here rather than baked into a public GHCR image.

# VCS and local tooling state
.git/
.gitignore
.github/
.venv/
venv/

# Python build/test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/

# Tests are not needed to build or run this image
tests/

# Never ship local secrets or env overrides into an image
.env
.env.*
!.env.example
secrets/
secrets.example/

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
