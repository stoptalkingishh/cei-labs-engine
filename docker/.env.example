# docker/.env.example
# Copy to docker/.env and fill in. docker/.env is gitignored — never commit real values.
# Consumed by `docker stack deploy` for variable interpolation into docker/stack.yml.
#
# Real credentials (DB passwords, secret keys, CTF key, admin passwords) are NOT here —
# they live as Docker Swarm secrets under docker/secrets/ (see docker/secrets.example/).

# ── Domain & TLS ────────────────────────────────────────────────────────────
# For LAN/air-gapped events, leave as a .local domain and use a self-signed cert.
# For internet-facing events, point a wildcard DNS record at your swarm and set USE_LETSENCRYPT=true.
#
# STABLE-ENDPOINT WARNING: Traefik's HostRegexp fallback (docker/stack.yml's
# ctfd router) lets a bare LAN IP reach CTFd even without DNS, but that IP is
# a station property, not a repo property — it changes on DHCP renewal,
# NIC/switch changes, or moving the station. Do NOT copy the station's
# current IP into player-facing launch instructions or a printed handout and
# treat it as permanent; it WILL go stale (this is exactly what happened
# with the 192.168.1.131 -> unreachable incident — see
# docs/network-prerequisites.md's "Stable access endpoint" section and
# docs/P1-FIX-LOG-2026-07-23.md). Prefer resolving `${BASE_DOMAIN}` via real
# DNS or a distributed hosts entry; if you must fall back to a bare IP,
# re-verify and re-document it immediately before each event, not once
# and forget.
BASE_DOMAIN=ctf.local
ACME_EMAIL=admin@example.com
USE_LETSENCRYPT=false

# Set true at venues with no DNS server resolving *.apps.${BASE_DOMAIN} at
# all (confirmed permanent for a given venue, not a temporary outage).
# When true, the orchestrator stops generating the hostname-based attacker
# workstation link entirely and returns the direct-IP noVNC address as the
# one and only link players see -- always works, nothing to explain.
# Leave false anywhere DNS (real or cei-labs-net's own) actually resolves.
ORCHESTRATOR_OFFLINE_MODE=false

# ── GitHub Container Registry ────────────────────────────────────────────────
GITHUB_ORG=your-github-org
# NEVER use `latest` for an event deployment — it's a mutable tag, so a
# rebuild after you've frozen the release candidate can silently change what
# gets deployed. build-ctfd.yml/build-orchestrator.yml tag every push to
# main as `sha-<7-char-commit-sha>` (immutable, one tag per commit) — pin to
# that. Find the current one: `git rev-parse --short=7 HEAD` on the release
# commit, or check the GHCR package page for the tag list.
IMAGE_TAG=sha-REPLACE_WITH_COMMIT_SHA

# ── Challenge Instance Orchestrator ──────────────────────────────────────────
# Maximum concurrent on-demand instances (Juice Shop + target/attacker combined)
ORCHESTRATOR_MAX_INSTANCES=30
# Maximum concurrent instance groups owned by one participant/team. In-flight
# launches count immediately, so parallel requests cannot race past this cap.
ORCHESTRATOR_MAX_INSTANCES_PER_OWNER=3
# Hard resource ceiling for each participant-controlled target/attacker.
ORCHESTRATOR_WORKLOAD_MEMORY_LIMIT_MB=512
ORCHESTRATOR_WORKLOAD_MEMORY_RESERVATION_MB=128
ORCHESTRATOR_WORKLOAD_CPU_LIMIT=1.0
# Idle instances/ranges are torn down after this many minutes of inactivity
ORCHESTRATOR_IDLE_GRACE_MINUTES=120
# Absolute lifetime even when a participant keeps touching the instance.
ORCHESTRATOR_MAX_INSTANCE_LIFETIME_MINUTES=240
# Reclaim creation reservations left behind by a crashed worker.
ORCHESTRATOR_RESERVATION_TIMEOUT_SECONDS=300
# Directly-published port range for `single-target` instances (SSH etc.) —
# kept disjoint from ANALYST_BASE_PORT below so the two provisioning paths
# (self-service orchestrator vs. bulk spawn-workspaces.sh) never collide.
ORCHESTRATOR_SSH_PORT_RANGE_START=32000
ORCHESTRATOR_SSH_PORT_RANGE_END=32767
# Post-solve auto-shutdown: how long after a correct flag before teardown,
# how much each "+5 more minutes" extension adds, and how many extensions
# a participant may use before the countdown can no longer be pushed out.
ORCHESTRATOR_SHUTDOWN_DELAY_SECONDS=30
ORCHESTRATOR_SHUTDOWN_EXTEND_SECONDS=300
ORCHESTRATOR_SHUTDOWN_MAX_EXTENSIONS=3

# ── Analyst / Kali workspace bulk-spawn defaults (scripts/spawn-workspaces.sh) ─
# Keep any roster's port usage (ANALYST_BASE_PORT + roster size) below 32000
# — see ORCHESTRATOR_SSH_PORT_RANGE_START above.
ANALYST_BASE_PORT=30001

# ── Node placement (set after `docker node update --label-add ctfd-data=true <node>`) ─
# Name of the manager node that should host stateful services (DB) and anything
# needing Docker socket access (orchestrator). Informational only — see README.
CTFD_DATA_NODE_LABEL=ctfd-data
