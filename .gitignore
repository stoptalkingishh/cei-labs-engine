# .gitignore
# Ignore running active credential matrices containing real secrets
ansible/group_vars/all.yml
creds.txt

# Docker Swarm deployment secrets/config (real values — see docker/secrets.example/, docker/.env.example)
docker/secrets/
docker/.env

# Traefik TLS material. docker/traefik/dynamic/tls.yml.example tells operators to
# copy it to tls.yml and drop the referenced cert/key files into
# docker/traefik/certs/ — walking them straight at a path nothing was ignoring.
# The .gitkeep keeps the directory in the tree; the negations are the only
# things from those two directories that should ever be tracked.
docker/traefik/certs/*
!docker/traefik/certs/.gitkeep
docker/traefik/dynamic/tls.yml

# Block local collection capture assets and memory drops
*.img
*.raw
*.vmem
*.pcap

# Local development overrides
.kube/
.idea/
.vscode/

# Python (orchestrator, CTFd plugin)
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/

# Local monitoring output, not repo-related (not referenced anywhere in this repo)
status-history.csv

# Local encrypted backup bundles (retain in protected operator storage)
backups/
