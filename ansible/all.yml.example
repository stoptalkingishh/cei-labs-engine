# ansible/group_vars/all.yml.example
# Copy this to all.yml and fill in every value.
# all.yml is gitignored — never commit real secrets.

# ── Cluster ────────────────────────────────────────────────────────────────
k3s_version: "v1.32.5+k3s1"
k3s_token: "CHANGE_ME_RANDOM_64_CHARS"

# Internal LAN IP range for MetalLB to hand out
# Set to a /28 or /29 block of unused IPs on your local network
metallb_ip_range: "192.168.1.200-192.168.1.220"

# ── GitHub Container Registry ──────────────────────────────────────────────
github_org: "your-github-org"
ghcr_token: "CHANGE_ME_GITHUB_PAT_WITH_PACKAGES_WRITE"

# ── CTFd ──────────────────────────────────────────────────────────────────
ctfd_secret_key: "CHANGE_ME_RANDOM_32_CHARS"
ctfd_db_password: "CHANGE_ME"
ctfd_db_root_password: "CHANGE_ME"
ctfd_admin_token: "CHANGE_ME_AFTER_FIRST_LOGIN"

# ── MultiJuicer / Juice Shop ───────────────────────────────────────────────
# This CTF key seeds flag generation for all Juice Shop instances.
# Change it before every event — flags change when this changes.
juiceshop_ctf_key: "CHANGE_ME_BEFORE_EVERY_EVENT"
multijuicer_admin_password: "CHANGE_ME"

# Maximum concurrent Juice Shop instances (set to participant count)
multijuicer_max_instances: 30

# ── Domain / Ingress ───────────────────────────────────────────────────────
# For air-gap/LAN events use a .local domain and /etc/hosts injection
# For internet-accessible events point a real domain to metallb_ip_range
base_domain: "ctf.local"

# ── Node SSH access ────────────────────────────────────────────────────────
# Base port for SSH analyst containers (increments per participant)
analyst_base_port: 2201
